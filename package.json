{
  "name": "nexora-office-3d",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA OFFICE 3D \u2014 interactive architectural headquarters with an operational agent/task layer.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-building.ts || node --experimental-strip-types scripts/validate-building.ts",
    "stats": "tsx scripts/scene-stats.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@react-three/test-renderer": "^9.1.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.186.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
